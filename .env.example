# ===== VARIÁVEIS ESSENCIAIS PARA O NETLIFY =====
# Copie estas variáveis para: Site Settings > Environment Variables

# 🔒 Verificação de Usuário (Pre-Land)
# Ativa o fluxo de verificação antes de acessar a página de recarga
NEXT_PUBLIC_ENABLE_USER_VERIFICATION=true

# 🚨 Gateway de Pagamento - Escolha entre 'blackcat' ou 'ghostpay'
PAYMENT_GATEWAY=ghostpay

# BlackCat (API de pagamento PIX)
BLACKCAT_API_AUTH=Basic YOUR_BLACKCAT_API_AUTH_HERE

# GhostPay (API alternativa de pagamento PIX)
GHOSTPAY_API_KEY=sk_live_YOUR_GHOSTPAY_KEY_HERE

# 🎯 OBRIGATÓRIO - UTMify (tracking de conversões)
UTMIFY_API_TOKEN=YOUR_UTMIFY_API_TOKEN_HERE
UTMIFY_ENABLED=true
UTMIFY_TEST_MODE=false

# 🔗 OBRIGATÓRIO - URL da Whitepage para conversão Google
UTMIFY_WHITEPAGE_URL=https://recarga-digitalgames.it.com
NEXT_PUBLIC_UTMIFY_WHITEPAGE_URL=https://recarga-digitalgames.it.com

# 🎯 Cloaker (AlterCPA)
NEXT_PUBLIC_CLOAKER_TRACKING_ENABLED=false
CLOAKER_FILTER_ID=969-8f076e082dbcb1d080037ec2c216d589-15311

# ===== OBSERVAÇÕES =====
# ✅ URLs são detectadas dinamicamente do host atual
# ✅ Webhooks funcionam automaticamente em qualquer domínio
