# =============================================================================
# 🎯 CONFIGURAÇÕES DA APLICAÇÃO
# =============================================================================

# URL base da aplicação (produção)
NEXT_PUBLIC_APP_URL=https://seudominio.com

# Ambiente atual
NODE_ENV=production

# =============================================================================
# 🎯 TIPO DE CAMPANHA
# =============================================================================
# LEAD = Modal inicial + conversão após validação
# VENDA = Acesso direto + conversão após compra
CAMPAIGN_TYPE=VENDA

# Sistema de verificação de usuário
# true = LEAD (modal de verificação ativo)
# false = VENDA (acesso direto)
NEXT_PUBLIC_ENABLE_USER_VERIFICATION=false

# =============================================================================
# 🔗 CONFIGURAÇÕES DE REDIRECIONAMENTO
# =============================================================================

# URL de redirect após completar ações
NEXT_PUBLIC_REDIRECT_URL=https://seudominio.com/redirect

# URL de callback para pagamentos
NEXT_PUBLIC_CALLBACK_URL=https://seudominio.com/callback

# =============================================================================
# 📊 ANALYTICS & TRACKING
# =============================================================================

# Google Analytics (opcional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Ads
NEXT_PUBLIC_GOOGLE_ADS_ENABLED=true
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX

# Cloaker AlterCPA
NEXT_PUBLIC_CLOAKER_TRACKING_ID=969-8f076e082dbcb1d080037ec2c216d589-16317
NEXT_PUBLIC_CLOAKER_TRACKING_ENABLED=true

# Labels de Conversão Google Ads
# Para CAMPANHA LEAD: usar apenas GTAG_CONVERSION_LEAD
NEXT_PUBLIC_GTAG_CONVERSION_LEAD=LeadLabelXXXXXX

# Para CAMPANHA VENDA: usar INITCHECKOUT e COMPRA
NEXT_PUBLIC_GTAG_CONVERSION_INITCHECKOUT=CheckoutLabelXXXXXX
NEXT_PUBLIC_GTAG_CONVERSION_COMPRA=CompraLabelXXXXXX

# UTMify - Tracking de Conversões
UTMIFY_API_TOKEN=sua_chave_utmify_aqui
UTMIFY_ENABLED=true
UTMIFY_TEST_MODE=false
UTMIFY_WHITEPAGE_URL=https://seudominio.com
NEXT_PUBLIC_UTMIFY_WHITEPAGE_URL=https://seudominio.com
NEXT_PUBLIC_PIXELID_UTMFY=seu_pixel_id_utmify

# Facebook Pixel (opcional)
NEXT_PUBLIC_FB_PIXEL_ID=XXXXXXXXXXXXXX

# Google Site Verification (opcional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code

# =============================================================================
# 🎮 CONFIGURAÇÕES DE JOGOS
# =============================================================================

# IDs dos jogos suportados
NEXT_PUBLIC_FREEFIRE_APP_ID=100067
NEXT_PUBLIC_DELTAFORCE_APP_ID=100068
NEXT_PUBLIC_HAIKYU_APP_ID=100069

# =============================================================================
# 🔐 SEGURANÇA (se necessário)
# =============================================================================

# Chave secreta para JWT (se usar autenticação)
JWT_SECRET=sua_chave_super_secreta_aqui_min_32_chars

# Chave de API interna (se usar APIs próprias)
API_SECRET_KEY=sua_api_key_secreta

# =============================================================================
# 💳 PAGAMENTOS (se integrar)
# =============================================================================

# Gateway de pagamento a ser usado (umbrela, blackcat, ghostpay)
PAYMENT_GATEWAY=umbrela

# Umbrela API
UMBRELA_API_KEY=sua_chave_umbrela_aqui

# BlackCat API (backup)
BLACKCAT_API_AUTH=sua_chave_blackcat_aqui

# GhostPay API (backup)
GHOSTPAY_API_KEY=sua_chave_ghostpay_aqui

# Webhook secret para validar callbacks de pagamento
PAYMENT_WEBHOOK_SECRET=sua_webhook_secret

# =============================================================================
# 📧 EMAIL (se usar notificações)
# =============================================================================

# SMTP para envio de emails
SMTP_HOST=smtp.seuservidor.com
SMTP_PORT=587
SMTP_USER=noreply@seudominio.com
SMTP_PASS=sua_senha_smtp

# =============================================================================
# 🗄️ BANCO DE DADOS (se usar)
# =============================================================================

# PostgreSQL/MySQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/db_name

# Redis para cache (se usar)
REDIS_URL=redis://localhost:6379
