      </div>

      {/* Conteúdo Principal */}
      <div className="flex-1 overflow-y-auto">
        {/* Login Section - REMOVIDO */}
        <div className="relative mx-auto max-w-5xl px-4 sm:px-[22px] md:px-8 pb-4 sm:pb-6" style={{ display: 'none' }}>
          <div id="login-section" className="group md:max-w-[464px]">
            <div className="mb-2 sm:mb-3 flex items-center justify-between text-lg sm:text-xl text-gray-800 md:text-2xl">
              <div className="flex items-center gap-2">
                <div className="grid items-center">
                  <svg
                    width="1em"
                    height="1em"
                    viewBox="0 0 24 24"
                    fill="none"
